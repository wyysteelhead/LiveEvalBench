# ============================================================================
# LiveEvalBench — environment configuration
# Copy to `.env` and fill in. Only the [REQUIRED] section must be set;
# everything else has sensible defaults and can be tuned later.
# ============================================================================

# ─── [REQUIRED] LLM provider & model ────────────────────────────────────────
# The judge/cognition model used by the evaluator agents, plus a perception
# (vision) model used when screenshots are involved. They may be the same model.

# Provider: anthropic | openai | google | custom  (custom = any OpenAI-compatible API)
MODEL_PROVIDER=custom

# Model IDs for your provider.
#   anthropic: claude-sonnet-4-5-20250929, claude-opus-4-5-20251101, ...
#   openai    : gpt-4o, gpt-4o-mini, ...
#   google    : gemini-2.0-flash-exp, gemini-1.5-pro, ...
#   custom    : whatever your provider serves (e.g. anthropic/claude-sonnet-4-5)
MODEL_NAME=
VISION_MODEL_NAME=

# API key for the chosen provider (only the one you use needs a real value).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Required only if MODEL_PROVIDER=custom (OpenRouter, Ollama, Together, etc.)
# Example (OpenRouter):  CUSTOM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://openrouter.ai/api/v1

# ─── [REQUIRED] local execution backend ─────────────────────────────────────
# The benchmark runs LOCALLY via Playwright — no sandbox service is needed.
EXECUTOR_BACKEND=playwright

# ─── Scoring / agent behavior (defaults are fine for most runs) ─────────────
# Disable extended thinking for faster, more reproducible scoring.
LLM_DISABLE_THINKING=true
TEMPERATURE=0
# Max ReAct iterations per agent (raise to ~80 for weaker/longer-horizon models).
MAX_AGENT_STEPS=80
# Agent runtime: react (LangGraph/ReAct) | claude_sdk (Anthropic Agent SDK)
AGENT_RUNTIME=react
# Hierarchical task decomposition (recommended).
TASK_SYNTHESIS_MODE=tree
# any-failed-subtask → main task score 0 (strict, recommended).
AGGREGATION_MODE=strict
# Number of recent tool rounds kept in full fidelity (older rounds drop images).
CONTEXT_KEEP_ROUNDS=15

# ─── LLM transient-error retry ──────────────────────────────────────────────
LLM_API_RETRY_COUNT=5
LLM_API_RETRY_BASE_DELAY_SECONDS=1.0
LLM_API_RETRY_JITTER_SECONDS=0.35
# Per-call HTTP timeout (seconds). Raise for slow providers.
LLM_REQUEST_TIMEOUT_SECONDS=300

# ─── Concurrency & rate limits (tune to your machine + provider quota) ──────
# Start LOW (e.g. ROW_PARALLELISM=4) and raise only if stable.
MAX_PARALLEL=64
ROW_PARALLELISM=4
BUILD_PARALLELISM=4
NPM_PREINSTALL_PARALLELISM=4
# 0 = inherit MAX_PARALLEL (no separate agent-stage ceiling).
EVALUATE_AGENT_PARALLELISM=0
HEAVY_EXEC_PARALLELISM=0
# Hard ceiling on simultaneous Chromium workers (set >0 to cap memory).
MAX_TOTAL_CHROMIUM_WORKERS=16
# Token-bucket rate limiters. Set 0 to disable.
LLM_CALLS_PER_SECOND=20
CDP_CONNECTS_PER_SECOND=16
# Small startup jitter to avoid bursty simultaneous requests.
EVAL_OPEN_TASK_START_JITTER_MS=250
LLM_PRE_CALL_JITTER_MS=100
# Per-row subtask workers in tree mode.
PER_ROW_WORKER_COUNT=1

# ─── Timeouts (seconds) ─────────────────────────────────────────────────────
# SANDBOX_STARTUP_TIMEOUT = npm install + workspace setup (raise for slow nets / big deps).
SANDBOX_STARTUP_TIMEOUT=300
APP_STARTUP_TIMEOUT=90
CDP_CONNECTION_TIMEOUT=30
APP_NAVIGATION_TIMEOUT=60
# Per-row wall-clock cap (0 = disable).
ROW_TIMEOUT=5400

# ─── Stability / backpressure ───────────────────────────────────────────────
DRAIN_ROW_WINDOW=5
DRAIN_LLM_ERRORS=30
DRAIN_MEMORY_PCT=85

# ─── Output & caching ───────────────────────────────────────────────────────
# Write results into rotating shard files (recommended for large runs); 0 = single file.
CHUNK_SIZE=10
# Persistent query fixed-task cache (relative path; keep inside the repo).
FIXED_TASK_DB_PATH=artifacts/cache/fixed_tasks.db

# Logging
LOG_LEVEL=INFO

# ─── Optional ───────────────────────────────────────────────────────────────
# Point to a specific Chromium binary (overrides Playwright's bundled one).
# CHROMIUM_BIN=/path/to/chrome-linux/chrome